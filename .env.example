# ─── AI — Google Gemini ──────────────────────────────────────────────────────
# Get your API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Primary model (the agent will cascade through fallbacks automatically)
GEMINI_MODEL=gemini-3.8-flash

# ─── Schedule ────────────────────────────────────────────────────────────────
# IANA timezone name — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
USER_TIMEZONE=America/New_York

# Day of week (monday … sunday) and time (24 h) for the weekly report
REPORT_DAY=friday
REPORT_HOUR=12
REPORT_MINUTE=0

# ─── Analysis window ─────────────────────────────────────────────────────────
# How many days back to look for emails (7 = full week)
DAYS_BACK=7

# Maximum number of email candidates passed to the AI triage step
MAX_EMAIL_CANDIDATES=100

# ─── Report recipient ────────────────────────────────────────────────────────
# Optional — leave empty to send the report to your own authenticated Gmail account
REPORT_RECIPIENT_EMAIL=
